# Contoh konfigurasi rahasia untuk Streamlit Cloud / lokal.
# Salin ke .streamlit/secrets.toml (JANGAN commit file aslinya).
# Di Streamlit Cloud: app -> Settings -> Secrets, tempel isi ini.

[auth]
# Kunci acak buat tanda tangan cookie. Bikin: python -c "import secrets;print(secrets.token_urlsafe(32))"
cookie_secret = "GANTI_DENGAN_STRING_ACAK_PANJANG"
# Akun admin pertama, dibuat otomatis saat app dibuka. Ganti passwordnya!
admin_user = "admin"
admin_password = "ganti-password-ini"

[google]
# OPSIONAL: kalau diisi, pengguna bisa langsung hubungkan channel tanpa
# upload client_secret.json sendiri. Kalau kosong, tiap user upload miliknya.
# Tipe "Web application" di Google Cloud Console.
# Authorized redirect URI harus persis URL app (tanpa path, tanpa "/" di akhir),
# mis. https://<nama-app>.streamlit.app  dan  http://localhost:8501
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
# OPSIONAL tapi disarankan: pin URL app di sini supaya nilai yang dikirim ke
# Google tidak pernah berubah (mencegah redirect_uri_mismatch).
# redirect_uri = "https://<nama-app>.streamlit.app"

[supabase]
# Project Settings -> API. Bikin tabel dulu (lihat README bagian Supabase).
url = "https://xxxx.supabase.co"
key = "eyJhbGci...service_role_atau_anon..."
