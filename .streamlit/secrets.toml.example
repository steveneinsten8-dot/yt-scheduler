# Contoh konfigurasi rahasia untuk Streamlit Cloud / lokal.
# Salin ke .streamlit/secrets.toml (JANGAN commit file aslinya).
# Di Streamlit Cloud: app -> Settings -> Secrets, tempel isi ini.

[auth]
# Kunci acak buat tanda tangan cookie. Bikin: python -c "import secrets;print(secrets.token_urlsafe(32))"
cookie_secret = "GANTI_DENGAN_STRING_ACAK_PANJANG"

[google]
# OAuth client TIPE "Web application" di Google Cloud Console.
# Authorized redirect URI harus persis URL app + "/" (tanpa path tambahan),
# mis. https://<nama-app>.streamlit.app  dan  http://localhost:8501
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"

[supabase]
# Project Settings -> API. Bikin tabel dulu (lihat README bagian Supabase).
url = "https://xxxx.supabase.co"
key = "eyJhbGci...service_role_atau_anon..."
